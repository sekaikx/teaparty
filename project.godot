; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tea Party"
config/description="A poisoned tea party: pour, bluff, swap, drink."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

Keys="*res://autoload/keys.gd"
Sfx="*res://autoload/sfx.gd"
Profile="*res://autoload/profile.gd"
Net="*res://autoload/net.gd"
Session="*res://autoload/session.gd"
Voice="*res://autoload/voice.gd"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/teaparty_theme.tres"

[rendering]

anti_aliasing/quality/msaa_3d=2
